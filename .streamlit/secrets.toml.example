# Copy to .streamlit/secrets.toml (git-ignored) for local runs, or paste into the app's
# Settings -> Secrets on Streamlit Community Cloud. Without a key the app runs in demo mode.
ANTHROPIC_API_KEY = "sk-ant-..."
# Optional:
# LLM_MODEL = "claude-sonnet-5-5"
# OPENAI_API_KEY = "sk-..."      # used if there is no Anthropic key
# LLM_PROVIDER = "openai"        # force a provider: anthropic, openai or mock
